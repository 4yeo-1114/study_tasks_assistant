  "chunks": [
    {"source": "auth.md", "chunk_id": 1, "text": "JWT 从 token 提取 user_id，owner_id 由服务端注入。"},
    {"source": "auth.md", "chunk_id": 2, "text": "owner_id 在 SQL 中过滤，避免跨用户读取。"},
