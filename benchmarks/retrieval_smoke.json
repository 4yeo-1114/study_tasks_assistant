    {"source": "proposals.md", "chunk_id": 2, "text": "confirm 事务与 idempotency_key 防止重复写入。"},
    {"source": "retrieval.md", "chunk_id": 1, "text": "RRF 按关键词与向量排名融合，不直接相加分数。"},
